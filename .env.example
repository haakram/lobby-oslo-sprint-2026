# Every environment variable the product reads. This file is committed; the real values go in .env
# (gitignored), shared privately between teammates, never in git, channels or screenshots. Secrets stay
# blank here; non-secret settings may carry their default. Add a variable here in the same PR that first
# reads it, and list it in docs/ARCHITECTURE.md § 4.4. Comments go on their own line: not every env
# parser strips them.

# --- Wybe Night Shift (Track A) ---
# Same endpoint for every team. The key is ours alone: one team, one key, never share it (Wybe rule).
WYBE_NIGHTSHIFT_URL=https://nightshift.wybe.me/
WYBE_NIGHTSHIFT_KEY=
# Global request limit across all shifts, requests per second (measured 20 clean, 429 above ~22).
NIGHTSHIFT_MAX_RPS=16
# Browser origins allowed to read the viewer's /api/* (comma-separated). Blank = http://localhost:3000 and http://127.0.0.1:3000.
VIEWER_ALLOWED_ORIGINS=
# The local viewer server the Lobby app asks for a live night (e.g. http://localhost:8765). Not a secret; optional:
# blank = the pages and the bell play the recorded night (public/runs) and ask no live server.
NEXT_PUBLIC_VIEWER_URL=
# Final-mode lock. Export it in the shell only on Sunday 12:00, e.g. `FINAL_ARMED=1 .venv/bin/python -m agent final`.
# A value in this file is ignored on purpose; the code also checks the time.
FINAL_ARMED=

# --- Claude API: agent brain, product recognition, voice commands, translation ---
ANTHROPIC_API_KEY=
# Hard cap on the product's Claude API spend for the whole event, in USD (AI_RULES R7.7). Not a secret.
ANTHROPIC_BUDGET_USD=30

# --- ElevenLabs: speech-to-text and text-to-speech (Track B) ---
# `npx -y @elevenlabs/cli@latest onboard connect` writes this to .env.local; .env works too.
ELEVENLABS_API_KEY=
# The Fettero voice agent (Stemme), printed by `npx tsx --env-file=.env src/features/voice/setup-agent.ts`.
# Not a secret; blank = Stemme says the voice is not on yet.
ELEVENLABS_AGENT_ID=
# Seconds until scripts/secrets.sh copy clears the clipboard (positive integer; not a secret).
SECRETS_CLEAR_AFTER=60

# --- Lobby login (the Next.js app: src/proxy.ts, /api/auth/*) ---
# Signs the session cookie: at least 32 random bytes. Rotating it logs everybody out.
# Generate: node scripts/lobby-hash.mjs --secret
# Missing or too short = nobody can log in (fail closed), and the server log says which variable.
LOBBY_AUTH_SECRET=
# The accounts and their roles, as scrypt hashes (never passwords): base64url JSON, or a plain JSON array of
# {"u","name","role","hash"}. Generate all four accounts: node scripts/lobby-hash.mjs --users <password>
LOBBY_USERS=

# --- AI receptionist on a real phone number (optional; leave blank for the in-app receptionist) ---
# The public https address of the deployed app, e.g. https://fettero.vercel.app. During a phone call
# ElevenLabs sends the receptionist's tool calls (prices, availability, requests) to
# <this address>/api/reception/tools/<tool>. Blank = tools run in the browser (the in-app demo).
RECEPTION_PUBLIC_URL=
# SECRET. A long random string (at least 24 characters), e.g. from `openssl rand -hex 32`. ElevenLabs
# sends it with every tool call so only ElevenLabs can post requests to our server. Put the real value
# only in your own .env and in Vercel's project settings, never in git.
RECEPTION_TOOL_SECRET=
