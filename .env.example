# Every environment variable the product reads. This file is committed; the real values go in .env
# (gitignored), shared privately between teammates, never in git, channels or screenshots. Secrets stay
# blank here; non-secret settings may carry their default. Add a variable here in the same PR that first
# reads it, and list it in docs/ARCHITECTURE.md § 4.4. Comments go on their own line: not every env
# parser strips them.

# --- Wybe Night Shift (Track A) ---
# Same endpoint for every team. The key is ours alone: one team, one key, never share it (Wybe rule).
WYBE_NIGHTSHIFT_URL=https://nightshift.wybe.me/
WYBE_NIGHTSHIFT_KEY=
# Global request limit across all shifts, requests per second (measured 20 clean, 429 above ~22).
NIGHTSHIFT_MAX_RPS=16
# Browser origins allowed to read the viewer's /api/* (comma-separated). Blank = http://localhost:3000 and http://127.0.0.1:3000.
VIEWER_ALLOWED_ORIGINS=
# Final-mode lock. Export it in the shell only on Sunday 12:00, e.g. `FINAL_ARMED=1 .venv/bin/python -m agent final`.
# A value in this file is ignored on purpose; the code also checks the time.
FINAL_ARMED=

# --- Claude API: agent brain, product recognition, voice commands, translation ---
ANTHROPIC_API_KEY=
# Hard cap on the product's Claude API spend for the whole event, in USD (AI_RULES R7.7). Not a secret.
ANTHROPIC_BUDGET_USD=30

# --- ElevenLabs: speech-to-text and text-to-speech (Track B) ---
# `npx -y @elevenlabs/cli@latest onboard connect` writes this to .env.local; .env works too.
ELEVENLABS_API_KEY=
# Seconds until scripts/secrets.sh copy clears the clipboard (positive integer; not a secret).
SECRETS_CLEAR_AFTER=60
