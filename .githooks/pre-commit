#!/usr/bin/env bash
# Shared pre-commit hook, installed by scripts/setup.sh (core.hooksPath). Fast on purpose: a slow hook
# gets skipped with --no-verify, so the heavy checks live in pre-push and CI. docs/OPERATIONS.md § 3.
set -euo pipefail

# 1. No commits on main. The first commit of a brand-new repo is allowed (there's no HEAD yet).
branch=$(git symbolic-ref --short HEAD 2> /dev/null || echo "")
if [ "$branch" = "main" ] && git rev-parse --verify -q HEAD > /dev/null && [ "${ALLOW_MAIN:-}" != "1" ]; then
  echo "✗ You're committing on main. Move your staged changes to a branch and commit there:" >&2
  echo "    git switch -c <your-name>/<topic>" >&2
  exit 1
fi

# 2. No env files (only .env.example).
staged_env=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env($|\.)' | grep -v '\.env\.example$' || true)
if [ -n "$staged_env" ]; then
  echo "✗ Refusing to commit env files:" >&2
  echo "$staged_env" | sed 's/^/    /' >&2
  echo "  Unstage with: git restore --staged <file>" >&2
  exit 1
fi

# 3. Secrets in the staged changes.
if command -v gitleaks > /dev/null 2>&1; then
  if ! gitleaks git --pre-commit --staged --no-banner --redact --verbose --log-level warn .; then
    echo "✗ gitleaks found what looks like a secret in the staged changes. Remove it and use .env." >&2
    echo "  False positive? Add a narrow allowlist entry to .gitleaks.toml (docs/OPERATIONS.md § 4)." >&2
    exit 1
  fi
else
  echo "! gitleaks not installed: staged changes were not scanned for secrets (brew install gitleaks)" >&2
fi

# 4. None of this machine's own keys in the staged changes, whatever their format. gitleaks knows the
#    common key formats; a custom one like the Wybe key could slip past it. Values are never printed.
staged_diff=$(git diff --cached -U0 --no-color)
for f in .env .env.local; do
  [ -f "$f" ] || continue
  while IFS= read -r line; do
    name=${line%%=*}
    value=$(printf '%s' "${line#*=}" | sed -E "s/^[\"' ]+|[\"' ]+$//g" | tr -d '\r')
    [ ${#value} -ge 8 ] || continue
    # A here-string, not a pipe: with pipefail, `git diff | grep -q` can report a match as a failure.
    if grep -qF -- "$value" <<< "$staged_diff"; then
      echo "✗ The value of $name (from $f) is in the staged changes. Remove it: keys live only in $f." >&2
      exit 1
    fi
  done < <(grep -E '^[A-Za-z_][A-Za-z0-9_]*(KEY|TOKEN|SECRET|PASSWORD)[A-Za-z0-9_]*=' "$f" || true)
done
